# ── Database / queue ─────────────────────────────────────────
DB_PASSWORD=changeme                                   # used by the postgres container
DATABASE_URL=postgresql+psycopg://hatm:changeme@postgres:5432/hatm
REDIS_URL=redis://redis:6379/0

# ── Adapters ─────────────────────────────────────────────────
# fake = in-memory Drive/Sheets/Zoom/Telegram/Gmail (demo data, no credentials)
# real = Google service account + Zoom S2S OAuth + Telegram bot
ADAPTER_MODE=fake

# Zoom — Server-to-Server OAuth (marketplace.zoom.us → Build App → S2S OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Google — service account JSON, mounted into the containers at /secrets
# ⚠️ share every task folder AND the tasks sheet with the service account's email
GOOGLE_SA_JSON=/secrets/service-account.json
# true when the folders live on a Shared Drive (adds supportsAllDrives everywhere)
DRIVE_SHARED_DRIVE=false
DRIVE_MAX_DEPTH=3
# Gmail sender (needs domain-wide delegation for the service account)
GMAIL_SENDER=

# Telegram — the team channel. @BotFather → /newbot → token.
# Each person sends /start to the bot once; store the chat id on Person.
TELEGRAM_BOT_TOKEN=

# ── AI service ───────────────────────────────────────────────
AI_SERVICE_URL=http://ai:8100
AI_TIMEOUT=10
# AI service: load sentence-transformers embeddings for ambiguous names (slow first start)
AI_USE_EMBEDDINGS=false

# ── Behaviour ────────────────────────────────────────────────
ZOOM_REPORT_RETRY_MINUTES=20
ZOOM_REPORT_MAX_RETRIES=6
APPROVAL_EXPIRY_HOURS=72
ANTISPAM_WINDOW_HOURS=24
ANTISPAM_MAX_MESSAGES=1
FEEDBACK_REMINDER_AFTER_HOURS=48
TIMEZONE=Africa/Cairo

# ── Feature flags (all off by default) ───────────────────────
# The system inspects, prepares and shows — it sends nothing — until these flip.
FF_SEND_TELEGRAM=false
FF_SEND_EMAIL=false
FF_WRITE_SHEET=false
FF_SCHEDULED_SCAN=false
FF_AUTO_CLOSE_SESSION=false

# ── API ──────────────────────────────────────────────────────
# Optional shared secret. Empty = no auth (local dev only).
API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
OPERATOR_NAME=hatem

# ── Frontend ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK=false
