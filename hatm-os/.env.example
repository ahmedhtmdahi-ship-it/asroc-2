# ── Database / queue ─────────────────────────────────────────
DB_PASSWORD=changeme                                   # used by the postgres container
DATABASE_URL=postgresql+psycopg://hatm:changeme@postgres:5432/hatm
REDIS_URL=redis://redis:6379/0

# ── Adapters ─────────────────────────────────────────────────
# fake = in-memory Zoom/Sheets/Gmail (demo data, no credentials needed)
# real = Zoom S2S OAuth + Google service account
ADAPTER_MODE=fake

# Zoom — Server-to-Server OAuth (marketplace.zoom.us → Build App → S2S OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Google — service account JSON, mounted into the containers at /secrets
GOOGLE_SA_JSON=/secrets/service-account.json
# Gmail sender (needs domain-wide delegation for the service account)
GMAIL_SENDER=

# ── AI service ───────────────────────────────────────────────
AI_SERVICE_URL=http://ai:8100
AI_TIMEOUT=10
# AI service: load sentence-transformers embeddings for ambiguous names (slow first start)
AI_USE_EMBEDDINGS=false

# ── Behaviour ────────────────────────────────────────────────
ZOOM_REPORT_RETRY_MINUTES=20
ZOOM_REPORT_MAX_RETRIES=6
APPROVAL_EXPIRY_HOURS=72
ANTISPAM_WINDOW_HOURS=24
ANTISPAM_MAX_MESSAGES=1
FEEDBACK_REMINDER_AFTER_HOURS=48
TIMEZONE=Africa/Cairo

# ── Feature flags (all off by default) ───────────────────────
FF_SEND_EMAIL=false
FF_AUTO_CLOSE_SESSION=false
FF_WHATSAPP=false

# ── API ──────────────────────────────────────────────────────
# Optional shared secret. Empty = no auth (local dev only).
API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
OPERATOR_NAME=hatem

# ── Frontend ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK=false
