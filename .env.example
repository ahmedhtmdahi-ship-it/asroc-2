# ─────────── نشر Docker (docker compose) ───────────
# انسخ الملف لـ .env وحُط سر قوي. docker-compose بيقرأه للـ JWT_SECRET.
# لازم 16 حرف على الأقل، وممنوع القيمة الافتراضية القديمة (السيرفر هيرفض يقلع).
#   مثال توليد سر:  openssl rand -base64 32
JWT_SECRET=

# ─────────── تطوير الواجهة محليًا (Vite) ───────────
# انسخ لـ .env.local وقت التطوير من غير Docker.
# مع نشر Docker الواجهة بتكلّم /api عبر بروكسي nginx (مش محتاجة الإعداد ده).
VITE_API_URL=http://localhost:4000
