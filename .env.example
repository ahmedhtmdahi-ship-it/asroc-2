# إعدادات الواجهة (Vite). انسخ الملف لـ .env.local

# عنوان الـ API (سيرفر الشركة). محليًا:
VITE_API_URL=http://localhost:4000

# ملاحظة: الـ auth بقى عبر الـ API، مش Supabase.
# متغيّرات Supabase القديمة (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY)
# لسه مستخدمة في بعض الـ stores لحد ما نكمّل التحويل في جولة النضافة.
