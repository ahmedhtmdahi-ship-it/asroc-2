# انسخ الملف ده لـ .env وعدّل القيم
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# سلسلة الاتصال بقاعدة البيانات (SQLite)
DATABASE_URL="file:./dev.db"

# مفتاح توقيع الـ JWT — لازم 16 حرف على الأقل. القيمة دي للتطوير المحلي فقط؛
# في production لازم سر عشوائي مختلف (السيرفر بيرفض القيمة الافتراضية القديمة).
#   توليد:  openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-in-prod

# باسورد حساب admin عند الزرع الأول — إلزامي في production.
# لو مش متحدد في التطوير، بيتولّد عشوائي ويتكتب في prisma/seed-output/seed-passwords.csv
SEED_ADMIN_PASSWORD=
