# انسخ الملف ده لـ .env وعدّل القيم
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# سلسلة الاتصال بـ PostgreSQL
DATABASE_URL=postgresql://asroc:asroc_dev_password@localhost:5432/asroc

# مفتاح توقيع الـ JWT — لازم 16 حرف على الأقل، وغيّره في production
JWT_SECRET=change-me-in-production-min-16-chars
