# انسخه لـ .env وعدّل القيم. الملف ده بيتعمل له commit، .env لأ.

# ── قاعدة البيانات ──────────────────────────────────────
# ملف واحد جنب المشروع. امسحه وشغّل python -m app.db عشان تبدأ من جديد.
DB_PATH=hatm.db

# ── شيت المهام ──────────────────────────────────────────
# الـ id من اللينك: docs.google.com/spreadsheets/d/<الـ id>/edit
SHEET_ID=
SHEET_TAB=المهام

# ── جوجل ────────────────────────────────────────────────
# مفتاح الـ service account. ⚠️ لازم تشارك الشيت والفولدر مع إيميله
# (شوف README) وإلا هتاخد 403/404 والمشكلة مش في الكود.
GOOGLE_SA_JSON=service-account.json

# خليها true لو فولدرات المشروع على Shared Drive مش My Drive.
# من غيرها الـ API بيرجّع ليست فاضية من غير أي خطأ — أسوأ نوع فشل.
DRIVE_SHARED_DRIVE=false
