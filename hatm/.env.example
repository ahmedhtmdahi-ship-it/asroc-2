# انسخه لـ .env وعدّل القيم. الملف ده بيتعمل له commit، .env لأ.

# ── قاعدة البيانات ──────────────────────────────────────
# ملف واحد جنب المشروع. امسحه وشغّل python -m app.db عشان تبدأ من جديد.
DB_PATH=hatm.db

# ── شيت المهام ──────────────────────────────────────────
# الـ id من اللينك: docs.google.com/spreadsheets/d/<الـ id>/edit
SHEET_ID=
SHEET_TAB=المهام

# ── جوجل ────────────────────────────────────────────────
# ملف الـ OAuth اللي نزّلته من الكونسول (نوع Desktop app).
# البرنامج بيشتغل بحسابك إنت، فبيشوف كل اللي إنت شايفه —
# مفيش مشاركة فولدرات ولا إيميل بوت.
GOOGLE_OAUTH_CLIENT=client_secret.json

# بيتعمل لوحده أول مرة تسجّل دخول، وبعدها مش هيسألك تاني.
# امسحه لو عايز تسجّل بحساب تاني.
GOOGLE_TOKEN=token.json
